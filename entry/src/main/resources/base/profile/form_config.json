      "supportDimensions": [
        "2*4"
      ]
    },
    {
      "name": "elec",
      "displayName": "$string:elec_display_name",
      "description": "$string:elec_desc",
      "src": "./ets/elec/pages/ElecCard.ets",
      "uiSyntax": "arkts",
      "window": {
        "designWidth": 720,
        "autoDesignWidth": true
      },
      "colorMode": "auto",
      "isDynamic": true,
      "isDefault": false,
      "updateEnabled": true,
      "updateDuration": 1,
      "defaultDimension": "2*2",
      "supportDimensions": [
